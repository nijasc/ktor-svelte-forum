{
    "openapi": "3.1.1",
    "info": {
        "title": "API",
        "version": "1.0"
    },
    "paths": {
        "/api/auth/login": {
            "post": {
                "summary": "",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credentials"
                            }
                        }
                    }
                },
                "responses": {
                    "401": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUser"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "summary": "",
                "responses": {
                    "204": {
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "summary": "",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUser"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "session": []
                    }
                ]
            }
        },
        "/api/auth/register": {
            "post": {
                "summary": "",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credentials"
                            }
                        }
                    }
                },
                "responses": {
                    "409": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUser"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/hello": {
            "get": {
                "summary": "",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Greeting"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/visits": {
            "post": {
                "summary": "",
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/VisitCount"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Greeting": {
                "type": "object",
                "title": "Greeting",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            },
            "VisitCount": {
                "type": "object",
                "title": "VisitCount",
                "required": [
                    "visits"
                ],
                "properties": {
                    "visits": {
                        "type": "integer"
                    }
                }
            },
            "Credentials": {
                "type": "object",
                "title": "Credentials",
                "required": [
                    "username",
                    "password"
                ],
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                }
            },
            "Problem": {
                "type": "object",
                "title": "Problem",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            },
            "CurrentUser": {
                "type": "object",
                "title": "CurrentUser",
                "required": [
                    "username"
                ],
                "properties": {
                    "username": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
            "session": {
                "name": "session",
                "in": "cookie",
                "description": "Session-based Authentication",
                "type": "apiKey"
            }
        }
    }
}
