{
    "openapi": "3.1.1",
    "info": {
        "title": "API",
        "version": "1.0"
    },
    "paths": {
        "/api/auth/login": {
            "post": {
                "summary": "",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credentials"
                            }
                        }
                    }
                },
                "responses": {
                    "401": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUser"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "summary": "",
                "responses": {
                    "204": {
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "summary": "",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUser"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "session": []
                    }
                ]
            }
        },
        "/api/auth/register": {
            "post": {
                "summary": "",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credentials"
                            }
                        }
                    }
                },
                "responses": {
                    "409": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUser"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/categories": {
            "get": {
                "summary": "",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Category"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/categories/{slug}/threads": {
            "post": {
                "summary": "",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/NewThread"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ThreadDetail"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "session": []
                    }
                ]
            },
            "get": {
                "summary": "",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ThreadPage"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/hello": {
            "get": {
                "summary": "",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Greeting"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/threads/{id}": {
            "get": {
                "summary": "",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "cursor",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ThreadDetail"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/threads/{id}/posts": {
            "post": {
                "summary": "",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/NewPost"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Post"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "session": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Credentials": {
                "type": "object",
                "title": "Credentials",
                "required": [
                    "username",
                    "password"
                ],
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                }
            },
            "Problem": {
                "type": "object",
                "title": "Problem",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            },
            "CurrentUser": {
                "type": "object",
                "title": "CurrentUser",
                "required": [
                    "id",
                    "username",
                    "role"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "username": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "member",
                            "moderator",
                            "admin"
                        ]
                    }
                }
            },
            "Category": {
                "type": "object",
                "title": "Category",
                "required": [
                    "slug",
                    "title",
                    "description"
                ],
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    }
                }
            },
            "ThreadSummary": {
                "type": "object",
                "title": "ThreadSummary",
                "required": [
                    "id",
                    "title",
                    "author",
                    "createdAt",
                    "replyCount",
                    "lastPostAt"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "author": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "replyCount": {
                        "type": "integer"
                    },
                    "lastPostAt": {
                        "type": "string"
                    }
                }
            },
            "ThreadPage": {
                "type": "object",
                "title": "ThreadPage",
                "required": [
                    "items"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ThreadSummary"
                        }
                    },
                    "next": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            },
            "Post": {
                "type": "object",
                "title": "Post",
                "required": [
                    "id",
                    "author",
                    "body",
                    "createdAt"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "author": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string"
                    }
                }
            },
            "PostPage": {
                "type": "object",
                "title": "PostPage",
                "required": [
                    "items"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Post"
                        }
                    },
                    "next": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            },
            "ThreadDetail": {
                "type": "object",
                "title": "ThreadDetail",
                "required": [
                    "id",
                    "category",
                    "title",
                    "author",
                    "createdAt",
                    "replyCount",
                    "posts"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "category": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "author": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "replyCount": {
                        "type": "integer"
                    },
                    "posts": {
                        "$ref": "#/components/schemas/PostPage"
                    }
                }
            },
            "NewThread": {
                "type": "object",
                "title": "NewThread",
                "required": [
                    "title",
                    "body"
                ],
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                }
            },
            "NewPost": {
                "type": "object",
                "title": "NewPost",
                "required": [
                    "body"
                ],
                "properties": {
                    "body": {
                        "type": "string"
                    }
                }
            },
            "Greeting": {
                "type": "object",
                "title": "Greeting",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
            "session": {
                "name": "session",
                "in": "cookie",
                "description": "Session-based Authentication",
                "type": "apiKey"
            }
        }
    }
}
