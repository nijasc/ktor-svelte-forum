{
    "name": "frontend",
    "private": true,
    "type": "module",
    "imports": {
        "#api": "./src/lib/api/index.ts",
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*",
        "#i18n": "./src/lib/ktor-svelte/i18n.ts",
        "#theme": "./src/lib/ktor-svelte/theme.ts",
