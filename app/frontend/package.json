        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.4",
        "daisyui": "^5.7.50",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
